generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BRAND
  CREATOR
  ADMIN

  @@map("role")
}

enum Status {
  ACTIVE
  DELETED

  @@map("status")
}

enum Industry {
  E_COMMERCE             @map("E-Commerce")
  FOOD_AND_BEVERAGE      @map("Food & Beverage")
  FASHION_AND_BEAUTY     @map("Fashion & Beauty")
  TECHNOLOGY             @map("Technology")
  FINANCE                @map("Finance")
  HEALTH_AND_WELLNESS    @map("Health & Wellness")
  ENTERTAINMENT          @map("Entertainment")
  EDUCATION              @map("Education")
  TRAVEL_AND_HOSPITALITY @map("Travel & Hospitality")
  OTHER                  @map("Other")

  @@map("industry")
}

enum Platform {
  TIKTOK

  @@map("platform")
}

enum CampaignStatus {
  DRAFT
  AWAITING_PAYMENT
  IN_REVIEW
  REVISION
  REJECTED
  ACTIVE
  FINISHED

  @@map("campaign_status")
}

enum SubmissionStatus {
  JOINED
  PENDING_REVIEW
  REVISION_REQUESTED
  REJECTED
  APPROVED
  POSTED
  VERIFIED

  @@map("submission_status")
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED

  @@map("payment_status")
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("payout_status")
}

enum WalletTransactionType {
  CAMPAIGN_EARNING
  WITHDRAWAL
  BRAND_DEPOSIT
  CAMPAIGN_PAYMENT
  CAMPAIGN_REFUND

  @@map("wallet_transaction_type")
}

enum MaterialType {
  VIDEO
  IMAGE
  DOCUMENT
  LINK

  @@map("material_type")
}

enum CampaignType {
  PRODUCT
  SERVICE
  CONTENT

  @@map("campaign_type")
}

enum Category {
  BEAUTY_SKINCARE    @map("Beauty & Skincare")
  FASHION_STYLE      @map("Fashion & Style")
  FOOD_BEVERAGE      @map("Food & Beverage")
  HEALTH_FITNESS     @map("Health & Fitness")
  TECHNOLOGY_GADGETS @map("Technology & Gadgets")
  LIFESTYLE          @map("Lifestyle")
  GAMING             @map("Gaming")
  TRAVEL             @map("Travel")
  ENTERTAINMENT      @map("Entertainment")
  OTHER              @map("Other")

  @@map("category")
}

model Account {
  // id is the primary key for the account, and is generated as a UUID.
  id String @id @default(uuid())

  // email is unique to prevent duplicate accounts
  email String @unique

  /// passwordHash is used to store the hashed password of the user. .
  passwordHash String @map("password_hash")

  // role is used to determine the type of user (brand, creator, or admin). 
  role Role

  // isEmailVerified is used to determine if the user's email has been verified. 
  isEmailVerified Boolean @default(false) @map("is_email_verified")

  // status is used to determine if the user's account is active or deleted.
  status Status @default(ACTIVE)

  // createdAt and updatedAt are used to track when the account was created and last updated.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations to other models
  brand   Brand?
  creator Creator?
  admin   Admin?
  wallet  Wallet?

  @@map("accounts")
}

model Brand {
  // id is the primary key for the brand, and is generated as a UUID.
  id String @id @default(uuid())

  // companyName is the name of the brand, and is mapped to the company_name column in the database.  
  companyName String @map("company_name")

  // phoneNumber is the phone number of the brand, and is mapped to the phone_number column in the database.
  phoneNumber String? @map("phone_number")

  // industry is the industry of the brand, and is optional.
  industry Industry?

  // status is used to determine if the brand's account is active or deleted.
  status Status @default(ACTIVE)

  // createdAt and updatedAt are used to track when the brand was created and last updated.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations to account 
  account   Account @relation(fields: [accountId], references: [id])
  accountId String  @unique @map("account_id")

  // relation to campaigns 
  campaigns Campaign[]

  @@map("brands")
}

model Creator {
  // id is the primary key for the creator, and is generated as a UUID.
  id String @id @default(uuid())

  // fullName is the name of the creator, and is mapped to the full_name column in the database.
  fullName String @map("full_name")

  // avatarUrl is the profile picture of the creator, and is optional.
  avatarUrl String? @map("avatar_url")

  // status is used to determine if the creator's account is active or deleted.
  status Status @default(ACTIVE)

  // createdAt and updatedAt are used to track when the creator was created and last updated.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relation to account
  account   Account @relation(fields: [accountId], references: [id])
  accountId String  @unique @map("account_id")

  // relation to submissions
  submissions Submission[]

  // relation to social accounts
  socialAccounts CreatorSocialAccount[]

  // relation to temporary social verification challenges
  verificationCodes SocialVerificationCode[]

  @@map("creators")
}

model Admin {
  // id is the primary key for the admin, and is generated as a UUID.
  id String @id @default(uuid())

  // fullName is the name of the admin, and is mapped to the full_name column in the database.
  fullName String @map("full_name")

  // status is used to determine if the admin's account is active or deleted.
  status Status @default(ACTIVE)

  // createdAt and updatedAt are used to track when the admin was created and last updated.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relation to account
  account   Account @relation(fields: [accountId], references: [id])
  accountId String  @unique @map("account_id")

  // relation to processed payouts
  processedPayouts PayoutRequest[]

  // relation to verified campaign payments
  verifiedPayments CampaignPayment[]

  // relation to verified top up requests
  verifiedTopUps TopUpRequest[]

  @@map("admins")
}

model Campaign {
  // id is the primary key for the campaign, and is generated as a UUID.
  id String @id @default(uuid())

  // title is the title of the campaign, and is optional until the creation wizard fills it in.
  title String?

  // description is the description of the campaign, and is optional until the creation wizard fills it in.
  description String?

  // campaignType is the type of campaign, and is required. It is stored as an enum with the following values: PRODUCT, SERVICE, CONTENT.
  campaignType CampaignType @default(PRODUCT) @map("campaign_type")

  // campaignCategory is the category of the campaign, and is required.
  campaignCategory Category @default(OTHER) @map("category")

  // thumbnailUrl is the URL of the thumbnail for the campaign, and is optional.
  thumbnailUrl String? @map("thumbnail_url")

  // platform is the platform of the campaign, and is required. Currently only TIKTOK is supported.
  platform Platform @default(TIKTOK)

  // mainMediaUrl is the URL of the main media for the campaign, and is optional. It can be a URL of a product, service or content.
  mainMediaUrl String? @map("main_media_url")

  // cpm is the cost per mille (CPM) of the campaign, and is optional. It is stored as a decimal with 12 digits and 2 decimal places.
  cpm Decimal? @db.Decimal(12, 2)

  // minViews and maxViews are the minimum and maximum views for the campaign, and are optional.
  minViews Int? @map("min_views")
  maxViews Int? @map("max_views")

  // budget is the total budget for the campaign, and is optional. It is stored as a decimal with 15 digits and 2 decimal places.
  budget Decimal? @db.Decimal(15, 2)

  // startDate and endDate are the start and end dates for the campaign, and are optional.
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  // status is used to determine if the campaign is active or deleted.
  status Status @default(ACTIVE)

  // campaignStatus is the lifecycle status of the campaign, and is required. It is stored as an enum with the following values: DRAFT, IN_REVIEW, REVISION, REJECTED, ACTIVE, FINISHED.
  campaignStatus CampaignStatus @default(DRAFT) @map("campaign_status")

  // adminNote is the feedback from the admin for revision or rejection, and is optional.
  adminNote String? @map("admin_note")

  // isFeatured indicates if the campaign is pinned to the featured carousel.
  isFeatured Boolean @default(false) @map("is_featured")

  // featuredBannerUrl is the custom wide landscape banner for the featured hero carousel.
  featuredBannerUrl String? @map("featured_banner_url")

  // featuredOrder controls the carousel slide sorting order.
  featuredOrder Int? @map("featured_order")

  // featuredUntil defines the expiration timestamp of the featured placement.
  featuredUntil DateTime? @map("featured_until")

  // createdAt and updatedAt are used to track when the campaign was created and last updated.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relation to brand  
  brand   Brand  @relation(fields: [brandId], references: [id])
  brandId String @map("brand_id")

  // relation to campaign brief
  brief CampaignBrief?

  // relation to campaign materials
  materials CampaignMaterial[]

  // relation to submissions
  submissions Submission[]

  // relation to wallet transactions
  walletTransactions WalletTransaction[]

  // relation to campaign payments
  payments CampaignPayment[]

  @@index([status, campaignStatus, isFeatured])
  @@map("campaigns")
}

model CampaignBrief {
  // id is the primary key for the campaign brief, and is generated as a UUID.
  id String @id @default(uuid())

  // purpose is the purpose of the campaign brief, and is optional.
  purpose String?

  // keyMessage is the key message of the campaign brief, and is optional.
  keyMessage String? @map("key_message")

  // narration is the narration of the campaign brief, and is optional.
  narration String?

  // impression is the impression of the campaign brief, and is optional.
  impression String?

  // callToAction is the call to action of the campaign brief, and is optional.
  callToAction String? @map("call_to_action")

  // requiredCaption is the required caption of the campaign brief, and is optional.
  requiredCaption String? @map("required_caption")

  // hashtags is the list of hashtags of the campaign brief, and is optional.
  hashtags String[]

  // mentionTags is the list of mention tags of the campaign brief, and is optional.
  mentionTags String[] @map("mention_tags")

  // dos is the list of dos of the campaign brief, and is optional.
  dos String[]

  // donts is the list of donts of the campaign brief, and is optional.
  donts String[]

  // guidelines is the free-form clipping brief of the campaign brief, and is optional.
  guidelines String?

  // status is used to determine if the campaign brief is active or deleted.
  status Status @default(ACTIVE)

  //  createdAt and updatedAt are used to track when the campaign brief was created and last updated.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relation to campaign
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String   @unique @map("campaign_id")

  @@map("campaign_briefs")
}

model CampaignMaterial {
  // id is the primary key for the campaign material, and is generated as a UUID.
  id String @id @default(uuid())

  // name is the name of the campaign material, and is required.
  name String

  // type is the type of the campaign material, and is required. It is stored as an enum with the following values: VIDEO, IMAGE, DOCUMENT, LINK.
  type MaterialType

  // url is the URL of the campaign material, and is required.
  url String

  // status is used to determine if the material is active or soft-deleted. Old materials are marked DELETED
  // instead of being removed, so any data still referencing them keeps working.
  status Status @default(ACTIVE)

  // createdAt and updatedAt are used to track when the campaign material was created and last updated.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relation to campaign
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String   @map("campaign_id")

  @@map("campaign_materials")
}

model Submission {
  // id is the primary key for the submission, and is generated as a UUID.
  id String @id @default(uuid())

  // draftVideoUrl is the URL of the draft video for the submission, and is optional.
  draftVideoUrl String? @map("draft_video_url")

  // liveVideoUrl is the URL of the live published video on TikTok, and is optional until submitted.
  liveVideoUrl String? @map("live_video_url")

  // thumbnailUrl is the preview thumbnail URL of the selected TikTok video.
  thumbnailUrl String? @map("thumbnail_url")

  // videoCaption is the caption of the selected TikTok video.
  videoCaption String? @map("video_caption")

  // status is used to determine if the submission is active or deleted.
  status Status @default(ACTIVE)

  // submissionStatus is the lifecycle status of the submission.
  submissionStatus SubmissionStatus @default(JOINED) @map("submission_status")

  // reviewNote is the feedback from the brand for revision or rejection, and is optional.
  reviewNote String? @map("review_note")

  // verifiedViews is the number of verified views for the submission, and is required. It is stored as an integer with a default value of 0.
  verifiedViews Int @default(0) @map("verified_views")

  // earnings is the earnings for the submission, and is required. It is stored as a decimal with 15 digits and 2 decimal places.
  earnings Decimal @default(0) @db.Decimal(15, 2)

  // submittedAt is the date and time when the submission was submitted, and is stamped on final submit.
  submittedAt DateTime? @map("submitted_at")

  // createdAt and updatedAt are used to track when the submission was created and last updated.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relation to campaign
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String   @map("campaign_id")

  // relation to creator
  creator   Creator @relation(fields: [creatorId], references: [id])
  creatorId String  @map("creator_id")

  // relation to connected social account
  socialAccount   CreatorSocialAccount? @relation(fields: [socialAccountId], references: [id])
  socialAccountId String?               @map("social_account_id")

  // relation to wallet transactions
  walletTransactions WalletTransaction[]

  @@unique([campaignId, creatorId])
  @@map("submissions")
}

model CreatorSocialAccount {
  // id is the primary key for the creator social account, and is generated as a UUID.
  id String @id @default(uuid())

  // creatorId references the creator who owns this social account.
  creatorId String @map("creator_id")

  // platform is the social media platform (currently TIKTOK).
  platform Platform @default(TIKTOK)

  // username is the handle of the creator on the platform without '@'.
  username String

  // platformUserId is the unique numeric or ID of the user on the platform.
  platformUserId String? @map("platform_user_id")

  // avatarUrl is the profile picture of the creator on the platform.
  avatarUrl String? @map("avatar_url")

  // followersCount is the number of followers on the platform.
  followersCount Int @default(0) @map("followers_count")

  // isVerified indicates whether bio verification was successfully completed.
  isVerified Boolean @default(false) @map("is_verified")

  // verificationCode is the temporary one-time verification token (e.g. KD-8123).
  verificationCode String? @map("verification_code")

  // verificationExpiresAt is when the verificationCode expires.
  verificationExpiresAt DateTime? @map("verification_expires_at")

  // verifiedAt is the timestamp when the account was successfully verified.
  verifiedAt DateTime? @map("verified_at")

  // status is used for soft-delete.
  status Status @default(ACTIVE)

  // createdAt and updatedAt timestamps.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  creator     Creator      @relation(fields: [creatorId], references: [id])
  submissions Submission[]

  @@unique([platform, username])
  @@index([creatorId, platform])
  @@map("creator_social_accounts")
}

model SocialVerificationCode {
  // id is the primary key for the verification challenge.
  id String @id @default(uuid())

  // creatorId references the creator requesting the verification.
  creatorId String @map("creator_id")

  // platform is the target social platform (e.g. TIKTOK).
  platform Platform @default(TIKTOK)

  // username is the social handle being claimed/verified without '@'.
  username String

  // code is the temporary verification token (e.g. KD-XXXX).
  code String

  // expiresAt defines when this challenge token expires.
  expiresAt DateTime @map("expires_at")

  // status is used for soft-delete.
  status Status @default(ACTIVE)

  // createdAt and updatedAt timestamps.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relation to creator
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, platform, username])
  @@index([platform, username])
  @@map("social_verification_codes")
}

model ErrorLog {
  id           String  @id @default(uuid())
  functionName String? @map("function_name")
  statusCode   Int?    @map("status_code")
  message      String  @db.Text
  stackTrace   String? @map("stack_trace") @db.Text

  // Context & Attribution
  endpoint  String?
  accountId String? @map("account_id")
  metadata  Json?

  // status is used for soft-delete.
  status Status @default(ACTIVE)

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([statusCode])
  @@map("error_logs")
}

model Wallet {
  // id is the primary key for the wallet, and is generated as a UUID.
  id String @id @default(uuid())

  // relation to account (can be brand or creator)
  account   Account @relation(fields: [accountId], references: [id])
  accountId String  @unique @map("account_id")

  // available balance in Rupiah (stored as decimal for precision)
  balance Decimal @default(0) @db.Decimal(15, 2)

  // saved destination account details for payouts (especially creators)
  accountProvider   String? @map("account_provider")
  accountNumber     String? @map("account_number")
  accountHolderName String? @map("account_holder_name")

  // status is used to determine if the wallet is active or soft-deleted.
  status Status @default(ACTIVE)

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  transactions   WalletTransaction[]
  payoutRequests PayoutRequest[]
  topUpRequests  TopUpRequest[]

  @@map("wallets")
}

model WalletTransaction {
  // id is the primary key for the transaction, and is generated as a UUID.
  id String @id @default(uuid())

  // human-readable reference code for receipt and auditing (e.g. TXN-2610-8912)
  referenceCode String? @unique @map("reference_code")

  // relation to wallet
  wallet   Wallet @relation(fields: [walletId], references: [id])
  walletId String @map("wallet_id")

  // type of transaction
  type WalletTransactionType

  // financial amounts
  amount        Decimal @db.Decimal(15, 2)
  balanceBefore Decimal @map("balance_before") @db.Decimal(15, 2)
  balanceAfter  Decimal @map("balance_after") @db.Decimal(15, 2)

  // transaction description
  description String

  // effective business transaction timestamp (distinct from technical db createdAt)
  transactionDate DateTime @default(now()) @map("transaction_date")

  // optional relations to campaign and submission
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?   @map("campaign_id")

  submission   Submission? @relation(fields: [submissionId], references: [id])
  submissionId String?     @map("submission_id")

  // status for soft-delete
  status Status @default(ACTIVE)

  // technical creation timestamp
  createdAt DateTime @default(now()) @map("created_at")

  @@index([walletId, transactionDate(sort: Desc)])
  @@index([campaignId])
  @@index([submissionId])
  @@map("wallet_transactions")
}

model PayoutRequest {
  // id is the primary key for the payout request, and is generated as a UUID.
  id String @id @default(uuid())

  // reference code for bank transfer remark (e.g. WD-91238)
  referenceCode String @unique @map("reference_code")

  // relation to wallet
  wallet   Wallet @relation(fields: [walletId], references: [id])
  walletId String @map("wallet_id")

  // requested withdrawal amount
  amount Decimal @db.Decimal(15, 2)

  // destination account snapshot at the time of request
  accountProvider   String @map("account_provider")
  accountNumber     String @map("account_number")
  accountHolderName String @map("account_holder_name")

  // payout status lifecycle
  payoutStatus     PayoutStatus @default(PENDING) @map("payout_status")
  rejectionReason  String?      @map("rejection_reason")
  transferProofUrl String?      @map("transfer_proof_url")
  adminNote        String?      @map("admin_note")

  // cancellation request tracking
  cancellationRequestedAt DateTime? @map("cancellation_requested_at")
  cancellationReason      String?   @map("cancellation_reason")

  // relation to processing admin
  processedByAdmin   Admin?    @relation(fields: [processedByAdminId], references: [id])
  processedByAdminId String?   @map("processed_by_admin_id")
  processedAt        DateTime? @map("processed_at")

  // status for soft-delete
  status Status @default(ACTIVE)

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([payoutStatus, createdAt(sort: Desc)])
  @@map("payout_requests")
}

model CampaignPayment {
  // id is the primary key for the campaign payment, and is generated as a UUID.
  id String @id @default(uuid())

  // relation to campaign
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String   @map("campaign_id")

  // financial details
  amount       Decimal @db.Decimal(15, 2)
  uniqueCode   Int     @map("unique_code")
  totalPayable Decimal @map("total_payable") @db.Decimal(15, 2)

  // destination bank account details (snapshot for invoice)
  destinationBank    String @default("BCA") @map("destination_bank")
  destinationAccount String @default("1234567890") @map("destination_account")

  // sender details
  senderProviderName String? @map("sender_provider_name")
  senderAccountName  String? @map("sender_account_name")
  transferProofUrl   String? @map("transfer_proof_url")

  // payment lifecycle status
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  rejectionReason String?       @map("rejection_reason")

  // relation to verifying admin
  verifiedByAdmin   Admin?    @relation(fields: [verifiedByAdminId], references: [id])
  verifiedByAdminId String?   @map("verified_by_admin_id")
  verifiedAt        DateTime? @map("verified_at")

  // status for soft-delete
  status Status @default(ACTIVE)

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([campaignId])
  @@index([paymentStatus, createdAt(sort: Desc)])
  @@map("campaign_payments")
}

model TopUpRequest {
  // id is the primary key for the top-up request, and is generated as a UUID.
  id String @id @default(uuid())

  // reference code for bank transfer remark (e.g. TU-2610-8912)
  referenceCode String @unique @map("reference_code")

  // relation to wallet
  wallet   Wallet @relation(fields: [walletId], references: [id])
  walletId String @map("wallet_id")

  // financial details
  amount       Decimal @db.Decimal(15, 2)
  uniqueCode   Int     @map("unique_code")
  totalPayable Decimal @map("total_payable") @db.Decimal(15, 2)

  // destination bank account details (snapshot for invoice)
  destinationBank       String @default("BCA") @map("destination_bank")
  destinationAccount    String @default("1234567890") @map("destination_account")
  destinationHolderName String @default("PT Klipday Media Kreasi") @map("destination_holder_name")

  // sender details
  senderBank         String? @map("sender_bank")
  senderAccountName  String? @map("sender_account_name")
  transferProofUrl   String? @map("transfer_proof_url")

  // top-up lifecycle status
  status          PaymentStatus @default(PENDING) @map("status")
  rejectionReason String?       @map("rejection_reason")

  // relation to verifying admin
  verifiedByAdmin   Admin?    @relation(fields: [verifiedByAdminId], references: [id])
  verifiedByAdminId String?   @map("verified_by_admin_id")
  verifiedAt        DateTime? @map("verified_at")

  // status for soft-delete
  recordStatus Status @default(ACTIVE) @map("record_status")

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([walletId])
  @@index([status, createdAt(sort: Desc)])
  @@map("top_up_requests")
}


