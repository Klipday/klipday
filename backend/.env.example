# Node Environment
NODE_ENV=production
PORT=3000

# Client & App URLs (replace with your production domains)
APP_URL="https://klipday.com"
CORS_ORIGIN="https://klipday.com,https://app.klipday.com"

# Cookie & HTTPS Configuration (Vercel Serverless)
COOKIE_SECURE="true"
COOKIE_SAME_SITE="none"
# COOKIE_DOMAIN=".klipday.com" # Uncomment if sharing session cookie across *.klipday.com subdomains

# Supabase Postgres Connection
# DATABASE_URL: Session Pooler (port 6543 or 5432) for runtime Prisma Client queries
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct DB connection (port 5432) for Prisma CLI migrations
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# JWT Secret (long random string, min 32 chars)
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Supabase Storage Configuration (for thumbnail and asset uploads)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="campaign-thumbnails"

# Social Account Scraper (TikTok verification & view sync)
SCRAPECREATORS_API_KEY="sc_live_xxxxxxxxxxxxxxxx"

# Email Service Configuration ("resend" recommended for production)
EMAIL_PROVIDER="resend"
EMAIL_FROM="Klipday <no-reply@klipday.com>"
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Option B: If using SMTP instead of Resend
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-google-app-password"

# Rekening Resmi Escrow Klipday (Informasi Transfer Brand Top-Up)
KLIPDAY_BANK_NAME="BCA"
KLIPDAY_BANK_ACCOUNT_NO="1234567890"
KLIPDAY_BANK_ACCOUNT_NAME="PT Klipday Media Indonesia"

# Serverless Scheduler Configuration
CRON_ENABLED="false"
CRON_TIMEZONE="Asia/Jakarta"

